<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="group20tup.matchingengine.controller.DashboardController"
            styleClass="root">
    <center>
        <StackPane fx:id="mapContainer">
            <Canvas fx:id="mapaCanvas" />
        </StackPane>
    </center>
    <right>
        <ScrollPane fx:id="sideScrollPane"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    minWidth="180" maxWidth="350">
            <VBox fx:id="sidePanel" spacing="8">
                <Label text="Panel de Control" styleClass="control-title" />
                <Label text="Algoritmo de ruteo" styleClass="section-title" />
                <ChoiceBox fx:id="algoritmoSelector" />
                <ProgressIndicator fx:id="floydProgress" visible="false" />
                <Label fx:id="lblFloydStatus" wrapText="true" styleClass="floyd-status" />
                <Button fx:id="btnResetView" text="Reset View" />
                <Button fx:id="btnToggleMapa" text="🗺 Mapa OSM" />
                <Label text="Simulacion" styleClass="section-title" />
                <HBox spacing="6">
                    <Button fx:id="btnPausar" text="⏸ Pausar" HBox.hgrow="ALWAYS" maxWidth="99999" />
                    <Label fx:id="lblVelocidad" text="1.0×" styleClass="speed-label" />
                </HBox>
                <Slider fx:id="sliderVelocidad" min="1.0" max="100" value="1.0"
                        showTickLabels="false" showTickMarks="false" />
                <Button fx:id="btnReiniciarSimulacion" text="🔄 Reiniciar Simulacion" maxWidth="99999"
                        styleClass="reset-button" />
                <Label text="Agregar vehiculos" styleClass="section-title" />
                <Label fx:id="lblVehicleCount" text="0 / 100" styleClass="info-label" />
                <HBox spacing="6" alignment="CENTER_LEFT">
                    <TextField fx:id="txtCantidadVehiculos" promptText="Cantidad" prefWidth="60" />
                    <Button fx:id="btnAgregarVehiculos" text="+ Agregar" maxWidth="99999" />
                </HBox>
                <Button fx:id="btnEliminarVehiculos" text="🗑 Eliminar Vehiculo" maxWidth="99999" />
                <Label text="Agregar usuarios" styleClass="section-title" />
                <Label fx:id="lblUserCount" text="0 / 80" styleClass="info-label" />
                <Button fx:id="btnColocarUsuario" text="📌 Colocar en mapa" maxWidth="99999" />
                <HBox spacing="6" alignment="CENTER_LEFT">
                    <TextField fx:id="txtCantidadUsuarios" promptText="Cantidad" prefWidth="60" />
                    <Button fx:id="btnAgregarUsuarios" text="+ Agregar" maxWidth="99999" />
                </HBox>
            </VBox>
        </ScrollPane>
    </right>
</BorderPane>
