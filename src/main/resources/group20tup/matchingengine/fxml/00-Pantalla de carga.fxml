<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="1650" 
            prefWidth="720" 
            style="-fx-background-color: white;" 
            xmlns="http://javafx.com/javafx/26" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="group20tup.matchingengine.controller.PantallaCargaController"> 

   <ImageView fx:id="logoImageView"
              fitHeight="338.0" 
              fitWidth="313.0" 
              layoutX="204.0" 
              layoutY="372.0" 
              pickOnBounds="true" 
              preserveRatio="true" 
              AnchorPane.leftAnchor="204.0" 
              AnchorPane.rightAnchor="203.0">
      <image><Image url="@Images/Logo.png" /></image>
   </ImageView>

       <!-- ① Rectángulo negro → "BIENVENIDO A" en blanco -->
  <StackPane fx:id="stackPaneBienvenido"
             layoutX="85.0" 
             layoutY="765.0" 
             maxWidth="550" 
             prefHeight="60" 
             prefWidth="550" 
             style="-fx-background-color: black;                                            
                    -fx-background-radius: 5;" 
             AnchorPane.leftAnchor="85.0" 
             AnchorPane.rightAnchor="85.0">

      <children>
           <Label    fx:id="bienvenidoALabel"
                     style="-fx-text-fill:   white;
                            -fx-font-family: 'Arial Black';                                                 
                            -fx-font-size:   30px;                                                 
                            -fx-font-weight: bold;" 
                         text="BIENVENIDO A" />
      </children>

  </StackPane>

     <!-- ② "MATCHING ENGINE" en fuente Stencil -->
  <Label fx:id="matchingEngineLabel"
         layoutX="93.0" 
         layoutY="905.0" 
         style="-fx-text-fill:   black;                                        
                -fx-font-family: 'Stencil';                                        
                -fx-font-size:   60px;                                        
                -fx-font-weight: bold;" 
         text="&quot;MATCHING ENGINE&quot;" 
         AnchorPane.leftAnchor="70.0" 
         AnchorPane.rightAnchor="70.0" />

     <!-- ③ Subtítulo en Arial Black -->
  <Label fx:id="subtituloLabel"
         alignment="CENTER" 
         layoutX="138.0" 
         layoutY="979.0" 
         text="&quot;Te conectamos con tu Destino...&quot;" 
         AnchorPane.leftAnchor="70.0" 
         AnchorPane.rightAnchor="70.0">
      <font><Font name="Calibri Bold" size="31.0" /></font>
  </Label>

      <!-- ④ Botón negro con texto blanco -->   
  <Button fx:id="btnAccion0" 
          alignment="CENTER" 
          layoutX="221.0" 
          prefHeight="64" 
          prefWidth="293.0" 
          onAction="#onIniciarClick" 
          style="-fx-background-color: black; 
                 -fx-background-radius: 16;" 
          text="I N I C I A R" 
          textFill="WHITE" 
          AnchorPane.bottomAnchor="169" 
          AnchorPane.leftAnchor="221.0" 
          AnchorPane.rightAnchor="221.0">
      <font><Font name="Calibri Bold" size="31.0" /></font>
  </Button>

</AnchorPane>
