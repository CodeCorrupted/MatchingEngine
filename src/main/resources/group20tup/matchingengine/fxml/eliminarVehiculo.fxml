<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="group20tup.matchingengine.controller.EliminarVehiculoController"
      prefWidth="380"
      style="-fx-background-color: white; -fx-border-color: #cccccc; -fx-border-width: 1;">

   <!-- Header -->
   <HBox style="-fx-background-color: #8B0000; -fx-padding: 6 10;">
      <Label text="— Eliminar Vehiculo —" textFill="WHITE">
         <font><Font name="Calibri Bold" size="13.0" /></font>
      </Label>
   </HBox>

   <!-- Vehicle count info -->
   <Label fx:id="lblInfo" style="-fx-padding: 6 10; -fx-background-color: #f5f5f5;" wrapText="true">
      <font><Font name="Calibri" size="12.0" /></font>
   </Label>

   <!-- ScrollPane with dynamic vehicle rows -->
   <ScrollPane fitToWidth="true" prefHeight="400.0"
               hbarPolicy="NEVER"
               style="-fx-background-color: transparent; -fx-border-width: 0;">
      <VBox fx:id="listaVehiculos" spacing="0" />
   </ScrollPane>

</VBox>
